    "motion": "^12.23.24",
    "papaparse": "^5.7.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
