# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
PORT=4000                            # plain Node entry (server/main.ts) only
DEPLOY_ENV=local                     # local | staging | production
LOG_LEVEL=info                       # fatal|error|warn|info|debug|trace|silent
TRUST_PROXY_HOPS=0                   # 1 behind Vercel; 0 locally

# ── Database ─────────────────────────────────────────────────────────────────
# Pooled (PgBouncer) URL for the running app. Neon: the "-pooler" host.
DATABASE_URL=postgresql://gerabyte_app:devpassword@127.0.0.1:5432/gerabyte_dev
# Direct URL, used ONLY by drizzle-kit migrations. Never at request time.
DATABASE_URL_UNPOOLED=postgresql://gerabyte_app:devpassword@127.0.0.1:5432/gerabyte_dev
# Separate database for the server test suite; it is truncated between tests.
TEST_DATABASE_URL=postgresql://gerabyte_app:devpassword@127.0.0.1:5432/gerabyte_test

# ── Origin ───────────────────────────────────────────────────────────────────
# Exact origin the SPA is served from. CSRF and CORS are checked against it.
# Must be https in production.
APP_ORIGIN=http://localhost:3000

# ── Secrets (generate with: openssl rand -base64 48) ─────────────────────────
# Rotating OTP_HMAC_SECRET invalidates every code in flight.
OTP_HMAC_SECRET=dev-only-otp-hmac-secret-change-me-32chars
# Rotating SESSION_HASH_SECRET signs everyone out.
SESSION_HASH_SECRET=dev-only-session-hash-secret-change-me-32chars
# Salts the IP hashes in the audit log so raw addresses are never stored.
IP_HASH_SECRET=dev-only-ip-hash-secret-16

# ── SMS ──────────────────────────────────────────────────────────────────────
SMS_PROVIDER=console                 # console | kavenegar
# KAVENEGAR_API_KEY=
# KAVENEGAR_OTP_TEMPLATE=gerabyte-otp

# ── Development escape hatches (never set these in production) ───────────────
# Accept 000000 as a valid OTP. Boot fails if this is on with NODE_ENV=production.
ALLOW_DEV_OTP=1
# Let a build ship with the mock API adapters still wired in (staging only).
ALLOW_MOCK_STAGING=0

# ── Client-visible (must be prefixed VITE_, never a secret) ──────────────────
# VITE_API_BASE_URL=
