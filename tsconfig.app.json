{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowJs": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": true
  },
  "include": ["src/**/*", "shared/**/*", "vite.config.ts"]
}
